# OpenAI API Key (Required for research agents, writer & critic chains)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (Required for web search tool)
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL Database Connection URL (e.g., postgresql://username:password@localhost:5432/research_db)
# If left empty, SQLite (sqlite:///./research.db) is automatically used as a local fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_db

# JWT Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_jwt_secret_key_here_at_least_32_characters_long
